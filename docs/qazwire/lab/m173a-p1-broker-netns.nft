# M1.7.3a P1: load ONLY into newly created qwhbXXXXXXXX broker netns.
# Worker lives in another netns with NO underlay interfaces or routes.
# Defense-in-depth UID match is NOT a per-process identity guarantee.
table inet qw_m173a_p1 {
    chain egress {
        type filter hook output priority filter; policy drop;
        ip saddr 198.18.27.1 ip daddr 198.18.27.2 udp dport 44000 meta skuid 65533 counter accept
    }
    chain ingress {
        type filter hook input priority filter; policy drop;
        ip saddr 198.18.27.2 ip daddr 198.18.27.1 udp sport 44000 counter accept
    }
}
