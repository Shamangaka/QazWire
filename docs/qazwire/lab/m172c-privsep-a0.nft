# QazWire M1.7.2c isolated-netns privileged controller / unprivileged worker lab.
# Load ONLY via: sudo ip netns exec <NEW_UNIQUE_WORKER_NETNS> nft -f this-file
# Never load in host namespace; never flush ruleset.
# Base chains are DROP before any interface is brought up.
table inet qw_privsep_a0 {
    set privileged_grants {
        type ipv4_addr
        flags timeout
        timeout 8s
        size 1
    }
    chain egress {
        type filter hook output priority 0; policy drop;
        ip saddr 198.18.28.1 ip daddr @privileged_grants udp dport 44000 counter accept
    }
    chain ingress {
        type filter hook input priority 0; policy drop;
        ip saddr 198.18.28.2 ip daddr 198.18.28.1 udp sport 44000 counter accept
    }
}
