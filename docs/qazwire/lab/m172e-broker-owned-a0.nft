# M1.7.2e — TEST ONLY. Load ONLY inside newly created qwfaXXXXXXXX worker netns.
# Non-root worker UID 65534 NEVER receives a direct-network exemption.
# Only a UDP socket owned by broker UID 65533 may transmit to a single peer.
# No timeout/grants: no permit exists for worker even if broker dies.
table inet qw_broker_a0 {
    chain egress {
        type filter hook output priority filter; policy drop;
        ip saddr 198.18.27.1 ip daddr 198.18.27.2 udp dport 44000 meta skuid 65533 counter accept
    }
    chain ingress {
        type filter hook input priority filter; policy drop;
        ip saddr 198.18.27.2 ip daddr 198.18.27.1 udp sport 44000 counter accept
    }
}
